"""CLI entry point — bootstraps PyFly and runs the shell on the application's event loop."""

import asyncio

from pyfly.core import PyFlyApplication

from {{ package_name }}.app import Application


def main() -> None:
    """Bootstrap and run the CLI application; the process exits with the command's exit code."""
    pyfly = PyFlyApplication(Application)
    raise SystemExit(asyncio.run(pyfly.run()))


if __name__ == "__main__":
    main()
