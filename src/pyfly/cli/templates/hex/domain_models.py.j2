"""Domain entities."""

from __future__ import annotations

import uuid
from dataclasses import dataclass, field
{% if has_data %}

from sqlalchemy import Boolean, Identity, String
from sqlalchemy.orm import Mapped, mapped_column

from pyfly.data.relational.sqlalchemy import Base
{% endif %}
{% if has_mongodb %}

from pyfly.data.document.mongodb import BaseDocument
{% endif %}


@dataclass
class Todo:
    """Core domain entity."""

    id: str = field(default_factory=lambda: str(uuid.uuid4()))
    title: str = ""
    description: str = ""
    completed: bool = False
{% if has_data %}


class TodoEntity(Base):
    """SQLAlchemy entity for relational persistence."""

    __tablename__ = "todos"

    # Identity(): an identity column on every backend (Oracle has no implicit autoincrement).
    id: Mapped[int] = mapped_column(Identity(), primary_key=True)
    title: Mapped[str] = mapped_column(String(200))
    # Optional text is nullable: Oracle stores an empty string as NULL.
    description: Mapped[str | None] = mapped_column(String(1000), default=None)
    completed: Mapped[bool] = mapped_column(Boolean, default=False)
{% endif %}
{% if has_mongodb %}


class TodoDocument(BaseDocument):
    """Beanie document for MongoDB persistence."""

    title: str
    description: str = ""
    completed: bool = False

    class Settings:
        name = "todos"
{% endif %}
