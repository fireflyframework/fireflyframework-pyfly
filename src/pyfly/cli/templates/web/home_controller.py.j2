"""Web controllers — serves HTML pages."""

from pyfly.container import controller
from pyfly.web import ModelAndView, get_mapping, request_mapping

from {{ package_name }}.services.page_service import PageService

@controller
@request_mapping("")
class HomeController:

    def __init__(self, page_service: PageService) -> None:
        self._page_service = page_service

    @get_mapping("/", name="home")
    async def home(self) -> ModelAndView:
        context = self._page_service.get_home_context()
        return ModelAndView("home.html", context)

    @get_mapping("/about", name="about")
    async def about(self) -> ModelAndView:
        context = self._page_service.get_about_context()
        return ModelAndView("about.html", context)
