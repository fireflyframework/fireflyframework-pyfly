"""Tests for the todo service: a data slice on a SQLite file whose units of work roll back after each test.

``@DataTest`` builds the slice with PyFly's pytest plugin (the ``data_context`` fixture). Point the
``pyfly_data_config`` fixture at a database container in ``conftest.py`` to run them on your production
database.
"""

import pytest

from pyfly.context.application_context import ApplicationContext
from pyfly.kernel.exceptions import ResourceNotFoundException
from pyfly.testing import DataTest

from {{ package_name }}.models.todo import TodoCreate
from {{ package_name }}.repositories.todo_repository import TodoRepository
from {{ package_name }}.services.todo_service import TodoService


@DataTest(beans=[TodoRepository, TodoService])
class TestTodoService:
    async def test_create_todo(self, data_context: ApplicationContext) -> None:
        service = data_context.get_bean(TodoService)
        todo = await service.create(TodoCreate(title="Buy groceries", description="Milk and eggs"))
        assert todo.title == "Buy groceries"
        assert todo.description == "Milk and eggs"
        assert todo.completed is False
        assert todo.id

    async def test_list_todos(self, data_context: ApplicationContext) -> None:
        service = data_context.get_bean(TodoService)
        await service.create(TodoCreate(title="Task A"))
        await service.create(TodoCreate(title="Task B"))
        assert len(await service.list_all()) == 2  # the rows of the other tests were rolled back

    async def test_get_todo(self, data_context: ApplicationContext) -> None:
        service = data_context.get_bean(TodoService)
        created = await service.create(TodoCreate(title="Buy groceries"))
        found = await service.get(created.id)
        assert found.title == "Buy groceries"
        assert found.description == ""

    async def test_toggle_complete(self, data_context: ApplicationContext) -> None:
        service = data_context.get_bean(TodoService)
        created = await service.create(TodoCreate(title="Buy groceries"))
        assert created.completed is False
        toggled = await service.toggle_complete(created.id)
        assert toggled.completed is True

    async def test_delete_todo(self, data_context: ApplicationContext) -> None:
        service = data_context.get_bean(TodoService)
        created = await service.create(TodoCreate(title="Buy groceries"))
        await service.delete(created.id)
        assert len(await service.list_all()) == 0
        with pytest.raises(ResourceNotFoundException):
            await service.get(created.id)
